# 复制为 .env 并填入你的真实 key。.env 已被 .gitignore 忽略，不会提交。
# 配置后运行 `rateyourdj-web` 或 `python -m rateyourdj.web.app` 会自动加载。

# DeepSeek（生成式发现引擎；不配则降级为规则路径）
DEEPSEEK_API_KEY=your-key-here
# 可选：覆盖默认模型和地址
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Spotify（候选事实落地、metadata、试听）
SPOTIFY_CLIENT_ID=your-key-here
SPOTIFY_CLIENT_SECRET=your-key-here

# Last.fm（标签、相似艺人）
LASTFM_API_KEY=your-key-here

# ListenBrainz（收听量、相似艺人；listenbrainz.org/settings/ 里的 User token）
LISTENBRAINZ_TOKEN=your-key-here

# MusicBrainz（无需 key，但请求头必须带联系方式）
MUSICBRAINZ_CONTACT=your-email@example.com

# YouTube Data API v3（只在 tail 歌要展示时搜索，结果缓存）
YOUTUBE_API_KEY=your-key-here
